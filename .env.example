# PayPal Sandbox REST app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: webhook ID for signature verification
PAYPAL_WEBHOOK_ID=
# LLM (leave empty to run in demo mode with simple heuristics)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Public URL of the app (PayPal redirects back here). Auto-set on Render.
BASE_URL=http://localhost:8000
